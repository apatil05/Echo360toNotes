# Required
GROQ_API_KEY=your_groq_api_key_here

# Optional — Obsidian vault output path (defaults to ./output if not set)
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
OBSIDIAN_SUBFOLDER=Echo360 Notes

# Optional — ffmpeg/ffprobe paths (defaults to system PATH).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional — server port (default: 3737)
SERVER_PORT=3737
