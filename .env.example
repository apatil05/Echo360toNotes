# ─── Notes model ─────────────────────────────────────────────────────────────
# Any OpenAI-compatible provider works.
# Presets: groq | nebius | openai | openrouter | ollama | custom
LLM_PROVIDER=groq

# Model ID. Leave blank to use the provider default
# (groq: openai/gpt-oss-120b, nebius: Qwen/Qwen3-235B-A22B-Instruct-2507).
# Required for openai / openrouter / ollama / custom.
# Run `npm run models` to list the IDs your key can use.
LLM_MODEL=

# API key. Each preset reads its own variable; LLM_API_KEY overrides whichever applies.
GROQ_API_KEY=your_groq_api_key_here
# NEBIUS_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# LLM_API_KEY=

# Only needed for LLM_PROVIDER=custom (LM Studio, vLLM, Together, DeepInfra, ...)
# LLM_BASE_URL=http://localhost:1234/v1

# Tuning. Defaults depend on the provider; Groq's are sized for its free-tier
# limit of 8,000 tokens/minute, other providers default to larger chunks and no delay.
# LLM_CHUNK_CHARS=12000
# LLM_CHUNK_DELAY_MS=62000
# LLM_MAX_OUTPUT_TOKENS=4096
# LLM_MAX_SLIDES_CHARS=4000
# LLM_TEMPERATURE=0.3
# LLM_REASONING_EFFORT=low

# ─── Transcription (only used when a lecture has no captions) ───────────────
# Presets: groq | openai | custom. Reads the same key variables as above.
TRANSCRIBE_PROVIDER=groq
# TRANSCRIBE_MODEL=whisper-large-v3
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=
# TRANSCRIBE_LANGUAGE=en
# TRANSCRIBE_MAX_MB=25

# ─── Output ──────────────────────────────────────────────────────────────────
# Obsidian vault output path (defaults to ./output if not set)
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
OBSIDIAN_SUBFOLDER=Echo360 Notes

# ffmpeg/ffprobe paths (defaults to system PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Server port (default: 3737). If you change it, also update SERVER_URL in
# extension/popup.js and host_permissions in extension/manifest.json.
SERVER_PORT=3737
