{
  "manifest_version": 3,
  "name": "Echo360 Notes Converter",
  "version": "1.1.0",
  "description": "Capture Echo360 lecture transcripts and send them to your local Notes Converter server.",
  "permissions": [
    "webRequest",
    "storage",
    "activeTab",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "*://*.echo360.org/*",
    "*://*.echo360.net.au/*",
    "*://*.echo360.org.uk/*",
    "*://*.echo360.ca/*",
    "*://content.echo360.org/*",
    "*://captions.echo360.org/*",
    "http://127.0.0.1:3737/*",
    "http://localhost:3737/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Echo360 Notes Converter"
  }
}
