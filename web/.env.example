# Supabase project (Project Settings -> API Keys). The publishable key is safe
# in the browser; row-level security protects the data.
# Local development: values from `supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Upload endpoint from the AWS stack (infra/cdk-outputs.json -> UploadUrlEndpoint).
VITE_UPLOAD_URL=

# Chrome extension ID (chrome://extensions) and, once published, its Web Store page.
VITE_EXTENSION_ID=
VITE_EXTENSION_STORE_URL=
