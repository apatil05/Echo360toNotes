{
  "name": "echo-notes-infra",
  "private": true,
  "type": "module",
  "description": "AWS pipeline (CDK) for uploads, transcription, and notes generation",
  "scripts": {
    "test": "node --test test/processJob.test.js test/uploads.test.js test/stack.test.js",
