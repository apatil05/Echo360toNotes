  "description": "Convert Echo360 lectures into Obsidian notes via a Chrome extension + local Node server (free, Groq-powered)",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "echo-notes": "./src/index.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "server": "node src/server.js",
    "cli": "node src/index.js"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "cors": "^2.8.6",
