{
  "name": "echo360-notes-converter",
  "version": "2.1.0",
  "description": "Convert Echo360 lectures into Obsidian notes via a Chrome extension + local Node server, using any OpenAI-compatible model (Groq, Nebius, OpenAI, OpenRouter, Ollama...)",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "echo-notes": "./src/index.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "server": "node src/server.js",
    "cli": "node src/index.js",
    "models": "node src/models.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.0",
    "express": "^4.22.3",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "echo360",
    "obsidian",
    "notes",
    "transcription",
    "lecture",
    "groq",
    "whisper",
    "llama",
    "chrome-extension"
  ],
  "license": "MIT"
}
